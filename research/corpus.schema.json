{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vocariri:corpus:effect-form:1",
  "title": "VOCALOID motion/effect form and occurrence evidence record",
  "type": "object",
  "required": ["sample_id", "source_url", "source_kind", "evidence_state", "effect_tags", "evidence"],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "source_kind": {"enum": ["public_video", "animation_template", "tutorial", "editable_project", "other_public_demo"]},
    "domain_specificity": {"enum": ["generic_motion_mechanism", "lyric_video_context_candidate", "vocaloid_pv_visual_observed"]},
    "form_id": {"type": ["string", "null"]},
    "variant_parameters": {"type": "object"},
    "video_title": {"type": ["string", "null"]},
    "artist_or_producer": {"type": ["string", "null"]},
    "video_platform_id": {"type": ["string", "null"]},
    "evidence_state": {
      "enum": ["discovered_video", "discovered_source", "metadata_only_candidate", "frame_inspected_segment", "motion_verified_segment", "source_inspected_form", "form_verified", "reviewed_sample"]
    },
    "segment_start_seconds": {"type": ["number", "null"], "minimum": 0},
    "segment_end_seconds": {"type": ["number", "null"], "minimum": 0},
    "effect_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "transition_in": {"type": ["string", "null"]},
    "transition_out": {"type": ["string", "null"]},
    "layering": {"type": "array", "items": {"type": "string"}},
    "motion_description": {"type": ["string", "null"]},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "kind"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "kind": {"enum": ["catalog", "video_page", "thumbnail", "frame", "video_interval", "template_preview", "tutorial_step", "project_file", "public_demo", "review_note"]},
          "artifact_member": {"type": ["string", "null"]},
          "observed_time_seconds": {"type": ["number", "null"], "minimum": 0},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$"},
          "retrieved_utc": {"type": ["string", "null"], "format": "date-time"}
        },
        "additionalProperties": false
      }
    },
    "review": {
      "type": ["object", "null"],
      "properties": {
        "reviewed_utc": {"type": "string", "format": "date-time"},
        "reviewer": {"type": "string"},
        "decision": {"enum": ["accept", "reject", "needs_second_review"]}
      },
      "required": ["reviewed_utc", "reviewer", "decision"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
