{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vocariri:pv-batch-02:observation:1",
  "title": "Source-grounded PV motion occurrence observation",
  "type": "object",
  "required": [
    "observation_id", "source_url", "source_title", "video_platform_id",
    "evidence_level", "segment_start_seconds", "segment_end_seconds",
    "visual_summary", "composition", "typography", "layers", "temporal_phases",
    "transition_in", "transition_out", "continuity", "form_id", "unknowns", "evidence"
  ],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "source_title": {"type": "string", "minLength": 1},
    "video_platform_id": {"type": "string", "minLength": 1},
    "source_kind": {"enum": ["public_video", "tutorial", "template_preview", "editable_project"]},
    "evidence_level": {"enum": ["frame_inspected_segment", "motion_verified_segment", "reviewed_sample"]},
    "segment_start_seconds": {"type": "number", "minimum": 0},
    "segment_end_seconds": {"type": "number", "minimum": 0},
    "visual_summary": {"type": "string"},
    "composition": {
      "type": "object",
      "required": ["layout", "framing", "density_change"],
      "properties": {
        "layout": {"type": "string"},
        "framing": {"type": "string"},
        "density_change": {"type": "string"},
        "palette": {"type": "string"},
        "background": {"type": "string"}
      },
      "additionalProperties": false
    },
    "typography": {
      "type": "object",
      "required": ["unit", "entry_behavior", "transform_behavior", "legibility"],
      "properties": {
        "unit": {"type": "string"},
        "entry_behavior": {"type": "string"},
        "transform_behavior": {"type": "string"},
        "legibility": {"type": "string"},
        "lyric_copy": {"type": "null", "default": null}
      },
      "additionalProperties": false
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["layer_id", "visual_role", "behavior"],
        "properties": {
          "layer_id": {"type": "string"},
          "visual_role": {"type": "string"},
          "behavior": {"type": "string"},
          "depth_or_overlap": {"type": "string"},
          "confidence": {"enum": ["high", "medium", "low"]}
        },
        "additionalProperties": false
      }
    },
    "temporal_phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start_seconds", "end_seconds", "observed_change"],
        "properties": {
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "minimum": 0},
          "observed_change": {"type": "string"},
          "visual_anchor": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "transition_in": {"type": "string"},
    "transition_out": {"type": "string"},
    "continuity": {"type": "string"},
    "effect_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "form_id": {"type": ["string", "null"]},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "evidence": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["kind", "url", "observed_time_seconds", "sha256", "artifact_member"],
        "properties": {
          "kind": {"enum": ["frame", "video_interval", "tutorial_step", "template_preview", "project_file"]},
          "url": {"type": "string", "format": "uri"},
          "observed_time_seconds": {"type": "number", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "artifact_member": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "review": {
      "type": ["object", "null"],
      "properties": {
        "reviewed_utc": {"type": "string", "format": "date-time"},
        "reviewer": {"type": "string"},
        "decision": {"enum": ["accept", "reject", "needs_second_review"]}
      },
      "required": ["reviewed_utc", "reviewer", "decision"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
