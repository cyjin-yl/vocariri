{
  "name": "vocariri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first word-timed lyric motion editor and deterministic CLI",
  "scripts": {
    "start": "node cli.mjs serve",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui.mjs",
    "desktop": "tauri dev",
    "build:web": "node scripts/build-web.mjs",
    "build:desktop": "tauri build",
    "check:desktop": "cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "bin": {
    "vocariri": "cli.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "playwright": "1.63.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src/",
    "index.html",
    "cli.mjs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY.md",
    "docs/product.md",
    "examples/"
  ],
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  }
}
